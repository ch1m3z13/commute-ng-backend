{
  "name": "commute-ng-backend",
  "version": "1.0.0",
  "description": "Backend API for CommuteNG - Exclusive commuting for Abuja professionals",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
