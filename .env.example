# Database
SUPABASE_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:3001/api/auth

# Email OTP (Mailtrap or any SMTP)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your-mailtrap-api-token
SMTP_FROM=noreply@mailtrap.io

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
