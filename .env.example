# Database
SUPABASE_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:3001/api/auth

# Email (Resend)
RESEND_API_KEY=re_your_key_here
RESEND_FROM=noreply@commuteng.com

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Testing
TEST_DATABASE_URL=postgresql://user:pass@host:5432/commute_ng_test
