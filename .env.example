# Database
SUPABASE_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:3001/api/auth

# Email (Resend)
# Register your domain at https://resend.com/domains
RESEND_API_KEY=re_your_key_here
RESEND_FROM=noreply@yourdomain.com

# Amazon Cognito (Google SSO)
COGNITO_DOMAIN=your-pool-id.auth.eu-west-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
COGNITO_REGION=eu-west-1

# Testing
TEST_DATABASE_URL=postgresql://user:pass@host:5432/commute_ng_test
